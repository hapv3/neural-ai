design -reset

read_liberty -lib tools/skywater-pdk/libraries/sky130_fd_sc_hd/latest/timing/sky130_fd_sc_hd__tt_025C_1v80.lib

read_slang --std 1800-2017 --single-unit -Wno-index-oob --unroll-limit 200000 \
    --no-proc \
    --ignore-timing --ignore-initial --ignore-assertions \
    --top systolic_ctrl_regs \
    -G ADDR_WIDTH=32 \
    -G DATA_WIDTH=32 \
    hw/rtl/systolic/systolic_ctrl_regs.sv

hierarchy -check -top systolic_ctrl_regs

proc_clean
proc_rmdead
proc_init
proc_arst
proc_rom
proc_mux
proc_dlatch
proc_dff
proc_memwr
proc_clean
opt_expr -keepdc
opt_clean -purge

memory_collect
memory_map

techmap
opt_clean -purge
dfflibmap -liberty tools/skywater-pdk/libraries/sky130_fd_sc_hd/latest/timing/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -fast -liberty tools/skywater-pdk/libraries/sky130_fd_sc_hd/latest/timing/sky130_fd_sc_hd__tt_025C_1v80.lib

rename systolic_ctrl_regs systolic_ctrl_regs_mapped
clean -purge
check
stat -liberty tools/skywater-pdk/libraries/sky130_fd_sc_hd/latest/timing/sky130_fd_sc_hd__tt_025C_1v80.lib
write_verilog -noattr -noexpr -nodec build/synth/systolic_ctrl_regs_sky130_tt.v
