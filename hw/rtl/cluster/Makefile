# Makefile for Cocotb Simulation of NPU Cluster

SIM ?= verilator
TOPLEVEL_LANG ?= verilog
VERILATOR_JOBS ?= 8
SYSTOLIC_OFM_FIFO_DEPTH ?= 8
SYSTOLIC_OTCDM_STALL_PERIOD ?= 0
SYSTOLIC_OTCDM_STALL_HOLD ?= 0

PWD=$(shell pwd)
REPO_ROOT=$(PWD)/../../..

# All RTL sources declared in snitch_minimal.F (template, uses $(REPO_ROOT))
# Expanded into snitch_expanded.F before passing to verilator.
SNITCH_F_TEMPLATE = $(PWD)/snitch_minimal.F
SNITCH_F_EXPANDED = $(SIM_BUILD)/snitch_expanded.F

# MODULE is the basename of the Python test file
export PYTHONPATH := $(PWD)/tb:$(PWD)/tb/tests:$(PYTHONPATH)
# Python test module
COCOTB_TEST_MODULES ?= test_snitch_boot
MODULE = $(COCOTB_TEST_MODULES)
CLUSTER_SIM_NAME ?= $(MODULE)

# Set build directory to tb/sim/<test_name>
SIM_BUILD = $(PWD)/tb/sim/$(CLUSTER_SIM_NAME)
SNITCH_F_STAMP = $(SIM_BUILD)/snitch_expanded.stamp

# TOPLEVEL is the name of the toplevel module in your Verilog
TOPLEVEL = tb_npu_cluster

# Cocotb requires at least one file in VERILOG_SOURCES to trigger build.
# All actual sources are in snitch_expanded.F via EXTRA_ARGS.
# We use the toplevel file as the "anchor" so verilator sees the module.
VERILOG_SOURCES = $(PWD)/tb/tb_npu_cluster.sv
CUSTOM_COMPILE_DEPS += $(SNITCH_F_STAMP)

# Verilator extra args: pass expanded .F which contains all other sources
EXTRA_ARGS += -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT -Wno-IMPLICIT -Wno-PINMISSING \
              --timing -DSNITCH_ENABLE_PERF -j $(VERILATOR_JOBS) \
              -GSYSTOLIC_OFM_FIFO_DEPTH=$(SYSTOLIC_OFM_FIFO_DEPTH) \
              -GSYSTOLIC_OTCDM_STALL_PERIOD=$(SYSTOLIC_OTCDM_STALL_PERIOD) \
              -GSYSTOLIC_OTCDM_STALL_HOLD=$(SYSTOLIC_OTCDM_STALL_HOLD)

# Cocotb's Verilator backend invokes `make -C $(SIM_BUILD) ... -f Vtop.mk`.
# Pass `-j` into that generated C++ build as well; Verilator's `-j` only
# parallelizes the Verilator frontend, not the generated model compilation.
BUILD_ARGS += -j$(VERILATOR_JOBS)

# Inject the expanded file list. snitch_expanded.F is generated by
# $(SNITCH_F_STAMP), which is also a compile dependency for Vtop.mk.
EXTRA_ARGS += -f $(SNITCH_F_EXPANDED)

# Enable VCD dumping if DEBUG=1
DEBUG ?= 0
ifeq ($(DEBUG), 1)
    EXTRA_ARGS += --trace
    export WAVES = 1
endif

# Include Cocotb's make rules
include $(shell cocotb-config --makefiles)/Makefile.sim

.PHONY: FORCE gen_f
FORCE:

# Generate expanded .F and a content stamp over the file list plus each listed
# RTL file. The stamp mtime only changes when content changes, which lets
# Verilator rebuild only when the effective -f inputs changed.
gen_f: $(SNITCH_F_STAMP)

$(SNITCH_F_STAMP): $(SNITCH_F_TEMPLATE) FORCE | $(SIM_BUILD)
	@sed 's|\$$(REPO_ROOT)|$(REPO_ROOT)|g' $(SNITCH_F_TEMPLATE) > $(SNITCH_F_EXPANDED)
	@set -e; { \
		sha256sum $(SNITCH_F_EXPANDED); \
		awk '{ sub(/\/\/.*/, ""); gsub(/^[ \t]+|[ \t]+$$/, ""); if ($$0 != "" && $$0 !~ /^\+/) print $$0; }' $(SNITCH_F_EXPANDED) | \
		while IFS= read -r f; do sha256sum "$$f"; done; \
	} > $(SNITCH_F_STAMP).tmp
	@if ! cmp -s $(SNITCH_F_STAMP).tmp $(SNITCH_F_STAMP); then \
		mv $(SNITCH_F_STAMP).tmp $(SNITCH_F_STAMP); \
	else \
		rm -f $(SNITCH_F_STAMP).tmp; \
	fi

# Keep the old explicit target and ensure sim has generated dependencies before
# Cocotb evaluates the Verilator compile rule.
sim: gen_f

# Clean output dir
clean::
	@rm -rf tb/sim __pycache__ tb/__pycache__ results.xml dump.vcd
